MODULE main

  VAR
    state : {locked, unlocked, fault};

IVAR

  action : {none, payed, pushed, shortage, fix};

ASSIGN
  init(state):=locked;
next(state):=case 
	       state= locked & action=shortage: fault;
	       state= unlocked & action=shortage: fault;
	       state=fault & action = fix: locked;
	       state=fault & action=payed: locked;
	       state=fault & action=pushed: locked;
	       state=fault & action=shortage: fault;
	       state  =locked & action = pushed: locked;
	       state = locked & action = payed : unlocked;
	       state = unlocked & action = pushed :locked;
	       state = unlocked & action =payed :unlocked;
	       TRUE : state;
	       
	       esac;
	       

	       
	       
	       
	       

	       
  LTLSPEC G (state = locked & action = pushed -> X (state = locked))
  LTLSPEC G (state = locked  -> F (state = unlocked))
